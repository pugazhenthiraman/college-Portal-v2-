generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CollegeStatus {
  PENDING
  REJECTED
  ACTIVE
}

enum UserRole {
  SUPER_ADMIN
  COLLEGE
  HOD
  FACULTY
  STUDENT
}

enum CollegeType {
  ENGINEERING
  ARTS
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())

  // One-to-one relations to role-specific details (only one should be non-null)
  superAdmin SuperAdmin?
  college    College?
  // Removed relation for department login
  hod        HOD?
  faculty    Faculty?
  student    Student?
}

model SuperAdmin {
  id     Int  @id @default(autoincrement())
  // One-to-one relation with User
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}

model College {
  id     Int  @id @default(autoincrement())
  // One-to-one relation with User
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  collegeType           CollegeType
  departmentType       String

  name                 String        @unique
  secondaryEmailId     String?       @unique
  address              String?
  affiliatedUniversity String
  deemedUniversity     String
  recognitionStatus    String
  instituteCode        String?
  councilIssuingCode   String
  remark               String?
  status               CollegeStatus @default(PENDING)
  createdAt            DateTime      @default(now())

  // Reverse relations
  departments Department[]
  hods        HOD[]
  faculty     Faculty[]
  students    Student[]
}

model Department {
  id        Int    @id @default(autoincrement())
  name      String
  collegeId Int
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  
  hod       HOD?

  faculty   Faculty[]
  students  Student[]
}

model HOD {
  id           Int         @id @default(autoincrement())
  userId       Int         @unique
  user         User        @relation(fields: [userId], references: [id])
  name         String
  phoneNo      String
  collegeId    Int
  college      College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId Int         @unique
  department   Department  @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  adhaarNo     String

  faculty      Faculty[]
  students     Student[]
}

model Faculty {
  id           Int         @id @default(autoincrement())
  userId       Int         @unique
  user         User        @relation(fields: [userId], references: [id])
  name         String
  collegeId    Int
  college      College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId Int
  department   Department  @relation(fields: [departmentId], references: [id])
  hodId        Int?
  hod          HOD?        @relation(fields: [hodId], references: [id])
  createdAt    DateTime    @default(now())
  students     Student[]   @relation("FacultyStudents")
}

model Student {
  id                 Int         @id @default(autoincrement())
  // One-to-one relation with User
  userId             Int         @unique
  user               User        @relation(fields: [userId], references: [id])
  
  // Name fields
  firstName          String
  middleName         String?
  lastName           String  

  photo              String?  

  personalEmailId    String  

  collegeId          Int
  college            College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  
  departmentId       Int?
  department         Department? @relation(fields: [departmentId], references: [id])
  
  facultyId          Int?
  faculty            Faculty?    @relation("FacultyStudents", fields: [facultyId], references: [id])
  
  hodId              Int?
  hod                HOD?        @relation(fields: [hodId], references: [id])
  
  rollNo             String      @unique
  
  DOB                DateTime
  phoneNo            String
  secondaryPhoneNo   String
  lastLogin          DateTime? 
  
  country        String
  district        String
  state           String
  departmentName     String

  adhaarNo           String?
  passportNo         String?
  passportExpiryDate DateTime?

  createdAt          DateTime    @default(now())
}
