generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CollegeStatus {
  PENDING
  REJECTED
  ACTIVE
}

enum UserRole {
  SUPER_ADMIN
  COLLEGE
  DEPARTMENT
  HOD
  FACULTY
  STUDENT
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())

  // One-to-one relations to role-specific details (only one should be non-null)
  superAdmin SuperAdmin?
  college    College?
  department Department?
  hod        HOD?
  faculty    Faculty?
  student    Student?
}


model SuperAdmin {
  id     Int  @id @default(autoincrement())
  // One-to-one relation with User
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}

model College {
  id                      Int           @id @default(autoincrement())
  // One-to-one relation with User
  userId                  Int           @unique
  user                    User          @relation(fields: [userId], references: [id])

  
  name                    String        @unique
  secondaryEmailId        String?        @unique
  address                 String?
  affiliatedUniversity   String
  deemedUniversity       String
  recognitionStatus      String
  instituteCode          String?
  councilIssuingCode      String
  remark                  String?
  status                  CollegeStatus @default(PENDING)
  createdAt               DateTime      @default(now())

  // Reverse relations
  departments             Department[]
  hods                    HOD[]
  faculty                 Faculty[]
  students                Student[]
}


model Department {
  id        Int      @id @default(autoincrement())
  // One-to-one relation with User (if you need department-specific authentication)
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  
  name      String
  collegeId Int
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  // One-to-one relation: each department may have one HOD
  hod       HOD?
  
  faculty   Faculty[]
  students  Student[]
}


model HOD {
  id           Int         @id @default(autoincrement())
  // One-to-one relation with User
  userId       Int         @unique
  user         User        @relation(fields: [userId], references: [id])
  
  name         String
  collegeId    Int
  college      College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId Int         @unique
  department   Department  @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  
  faculty      Faculty[]
  students     Student[]
}


model Faculty {
  id           Int        @id @default(autoincrement())
  // One-to-one relation with User
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  
  name         String
  collegeId    Int
  college      College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  
  hodId        Int?    
  hod          HOD?       @relation(fields: [hodId], references: [id])
  
  createdAt    DateTime   @default(now())
  students     Student[]  @relation("FacultyStudents")
}


model Student {
  id           Int        @id @default(autoincrement())
  // One-to-one relation with User
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  
  name         String
  collegeId    Int
  college      College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  
  facultyId    Int
  faculty      Faculty?   @relation("FacultyStudents", fields: [facultyId], references: [id])
  
  hodId        Int?
  hod          HOD?       @relation(fields: [hodId], references: [id])
  
  createdAt    DateTime   @default(now())
}
