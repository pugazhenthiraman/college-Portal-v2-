generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Strict levels for technical skills
enum TechnicalSkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CollegeStatus {
  PENDING
  REJECTED
  ACTIVE
}

enum UserRole {
  SUPER_ADMIN
  COLLEGE
  HOD
  FACULTY
  STUDENT
}

enum CollegeType {
  ENGINEERING
  ARTS
}

enum InternshipType {
  ONSITE
  WORK_FROM_HOME
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  password        String
  role            UserRole
  createdAt       DateTime @default(now())
  passwordChanged Boolean  @default(false)

  // One-to-one relations to role-specific details (only one should be non-null)
  superAdmin SuperAdmin?
  college    College?
  // Removed relation for department login
  hod        HOD?
  faculty    Faculty?
  student    Student?
}

model SuperAdmin {
  id     Int  @id @default(autoincrement())
  // One-to-one relation with User
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}

model College {
  id             Int         @id @default(autoincrement())
  // One-to-one relation with User
  userId         Int         @unique
  user           User        @relation(fields: [userId], references: [id])
  collegeType    CollegeType
  departmentType String

  name                 String        @unique
  secondaryEmailId     String?       @unique
  address              String?
  affiliatedUniversity String
  deemedUniversity     String
  recognitionStatus    String
  instituteCode        String?
  councilIssuingCode   String
  remark               String?
  status               CollegeStatus @default(PENDING)
  createdAt            DateTime      @default(now())

  // Reverse relations
  departments Department[]
  hods        HOD[]
  faculty     Faculty[]
  students    Student[]
}

model Department {
  id        Int     @id @default(autoincrement())
  name      String
  collegeId Int
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  hod      HOD?
  faculty  Faculty[]
  students Student[]
}

model HOD {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  name         String
  phoneNo      String
  collegeId    Int
  college      College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId Int        @unique
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
  adhaarNo     String

  faculty  Faculty[]
  students Student[]
}

model Faculty {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  name         String
  collegeId    Int
  college      College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  hodId        Int?
  hod          HOD?       @relation(fields: [hodId], references: [id])
  createdAt    DateTime   @default(now())
  students     Student[]  @relation("FacultyStudents")
  // New fields for storing additional data:

  contactNo String?
  aadhaarNo String?
  sections  String[] @default([])
}

model Student {
  id                 Int         @id @default(autoincrement())
  userId             Int         @unique
  user               User        @relation(fields: [userId], references: [id])
  firstName          String
  middleName         String?
  lastName           String
  photo              String? // file path or URL
  personalEmailId    String
  collegeId          Int
  college            College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId       Int?
  department         Department? @relation(fields: [departmentId], references: [id])
  facultyId          Int?
  faculty            Faculty?    @relation("FacultyStudents", fields: [facultyId], references: [id])
  hodId              Int?
  hod                HOD?        @relation(fields: [hodId], references: [id])
  rollNo             String      @unique
  DOB                DateTime
  phoneNo            String
  secondaryPhoneNo   String
  lastLogin          DateTime?
  country            String
  district           String
  state              String
  departmentName     String
  section            String?
  academicYear       String?
  pgBatch            String? // PG batch for summary/quick access
  sslcPercentage     String?
  hscPercentage      String?
  adhaarNo           String?
  passportNo         String?
  passportExpiryDate DateTime?
  panNo              String?     @db.VarChar(10) // PAN number, optional
  createdAt          DateTime    @default(now())

  // Submission & verification fields
  isSubmitted    Boolean   @default(false)
  isVerified     Boolean?
  facultyRemarks String?
  submittedAt    DateTime?
  verifiedAt     DateTime?

  // relations to form sections
  ugDetails       UGDetails? // <--- ONE-TO-ONE, not array!
  technicalSkills TechnicalSkill[]
  internships     Internship[]
  events          EnhancementProgram[]
  socialProfiles  SocialProfile[]
  placements      Placement[]
  workExperiences WorkExperience[]
  publications    Publication[]
  projects        Project[]

  @@index([academicYear, section])
}

model UGDetails {
  id                  Int      @id @default(autoincrement())
  studentId           Int      @unique
  student             Student  @relation(fields: [studentId], references: [id])
  ugBatch             String? // UG batch years, e.g., 2020-2024
  pgBatch             String? // PG batch years, e.g., 2024-2026
  semesterNo          String?
  semesterMarksheet   String?
  overallCGPA         String?
  overallPercentage   String?
  isPG                Boolean?
  pgSemesterNo        String?
  pgSemesterMarksheet String?
  pgOverallCGPA       String?
  pgOverallPercentage String?
}

model TechnicalSkill {
  id              Int                  @id @default(autoincrement())
  studentId       Int
  courseName      String? // was String
  details         String? // was String
  level           TechnicalSkillLevel? // was TechnicalSkillLevel
  certificateFile String?
  certificateName String?
  startDate       DateTime? // was DateTime
  endDate         DateTime? // was DateTime
  student         Student              @relation(fields: [studentId], references: [id])
}

model Internship {
  id               Int             @id @default(autoincrement())
  studentId        Int
  student          Student         @relation(fields: [studentId], references: [id])
  company          String
  role             String
  startDate        DateTime?
  endDate          DateTime?
  state            String?
  district         String?
  block            String?
  responsibilities String
  certificate      String? // file path or URL
  certificateName  String?
  createdAt        DateTime        @default(now())
  mode             InternshipType?
  stipend          String?
  supervisorName   String?
  companyEmail     String
}

model Project {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id])
  title       String
  link        String?
  startDate   DateTime
  endDate     DateTime
  description String
  category    String? // <-- add this
  githubRepo  String? // <-- add this
  createdAt   DateTime @default(now())
}

model EnhancementProgram {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id])
  name         String
  district     String
  block        String
  details      String
  contribution String
  createdAt    DateTime @default(now())
}

model SocialProfile {
  id        Int      @id @default(autoincrement())
  studentId Int      @unique
  student   Student  @relation(fields: [studentId], references: [id])
  github    String?
  gitlab    String?
  bitbucket String?
  linkedin  String?
  twitter   String?
  portfolio String?
  createdAt DateTime @default(now())
}

model Placement {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id])
  employer    String
  designation String
  onCampus    Boolean
  ctc         String
  createdAt   DateTime @default(now())
}

model WorkExperience {
  id               Int       @id @default(autoincrement())
  studentId        Int
  student          Student   @relation(fields: [studentId], references: [id])
  employer         String
  startDate        DateTime?
  endDate          DateTime?
  role             String
  responsibilities String
  ctc              String
  certificate      String? // <-- file path or URL
  certificateName  String? // <-- display name
  createdAt        DateTime  @default(now())
}

model Publication {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  title     String
  abstract  String
  publisher String
  link      String
  createdAt DateTime @default(now())

  @@index([publisher])
}

model District {
  id     Int     @id @default(autoincrement())
  name   String
  state  String // For now, just 'Tamil Nadu'
  blocks Block[]

  @@unique([name, state])
}

model Block {
  id         Int      @id @default(autoincrement())
  name       String
  district   District @relation(fields: [districtId], references: [id])
  districtId Int

  @@unique([name, districtId])
}
